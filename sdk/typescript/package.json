{
  "name": "@tbm/sdk",
  "version": "0.1.0",
  "description": "Token Budget Manager SDK — enforce token budgets between your agent and the LLM API.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
