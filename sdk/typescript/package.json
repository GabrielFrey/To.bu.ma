    "typecheck": "tsc -p tsconfig.json --noEmit",
    "example": "tsx example.ts"
  },
  "dependencies": {
    "js-tiktoken": "^1.0.14"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
