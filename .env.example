# ---- Token Budget Manager — environment (copy to .env for docker compose) ----

# Postgres (used by the db + backend services in docker-compose)
POSTGRES_USER=tbm
POSTGRES_PASSWORD=tbm_password
POSTGRES_DB=tbm

# Backend
# In Docker this is set automatically from the POSTGRES_* vars above. For local
# (non-Docker) runs the backend uses SQLite by default (backend/.env -> file:./dev.db).
# DATABASE_URL=postgresql://tbm:tbm_password@db:5432/tbm?schema=public

# 32+ byte secret used to encrypt provider keys at rest (AES-256-GCM) and sign tokens.
MASTER_KEY=change-me-please-32bytes-minimum-secret

# Transparent proxy upstream: "mock" (offline, default for compose) or "openai".
TBM_PROXY_UPSTREAM=mock

# Real provider (only needed when TBM_PROXY_UPSTREAM=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Public base URL used to build actionable approval links in notifications.
TBM_PUBLIC_URL=http://localhost:4000

# Outbound webhook delivery tuning (optional)
TBM_WEBHOOK_MAX_ATTEMPTS=5
TBM_WEBHOOK_BACKOFF_MS=1000
TBM_WEBHOOK_TIMEOUT_MS=5000

# Seed demo data on first boot (only seeds when the DB is empty)
TBM_SEED=true

# Optional: distributed token reservations via Redis (multi-node headroom).
# Unset → the default DB-backed reservation store (no extra infrastructure).
# REDIS_URL=redis://localhost:6379

# Optional: OpenTelemetry export. Unset → instrumentation stays on the no-op API
# (zero overhead, no collector required). Set an OTLP endpoint (or TBM_OTEL=1) to
# export traces (check-budget → provider call → record-usage) and the
# tbm.overhead.ms / tbm.provider.ms metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=tbm-backend
# TBM_OTEL=1

