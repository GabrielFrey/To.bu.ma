# Server-side only. These values must never reach the mobile bundle.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Image generation provider: gemini | openai
IMAGE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
GEMINI_TEXT_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TEXT_MODEL=gpt-4.1-mini

# Moderation
MODERATION_PROVIDER=openai
MODERATION_BLOCK_THRESHOLD=0.7

# RevenueCat -> Supabase webhook
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=

# Credit economics
FREE_GENERATION_CREDITS_GUEST=3
FREE_EXPORT_CREDITS_GUEST=1
SIGN_IN_BONUS_GENERATION_CREDITS=5
SIGN_IN_BONUS_EXPORT_CREDITS=3
GENERATION_COST=1
EXPORT_COST_PER_STICKER=1

# Rate limits (requests per window per user)
RATE_LIMIT_GENERATE_PER_HOUR=30
RATE_LIMIT_SUGGEST_PER_HOUR=60
