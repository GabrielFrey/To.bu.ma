# Copy to .env.local. Only EXPO_PUBLIC_* values are bundled into the app —
# never put a provider or service_role key here.

# Supabase project (Project settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (Project -> API keys -> App specific)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxx

# Observability
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Legal + support surfaces shown in Settings
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com

# Native identity
EXPO_PUBLIC_BUNDLE_ID=com.emetsolutions.stickermaker
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Build-time only (not bundled)
EAS_PROJECT_ID=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
